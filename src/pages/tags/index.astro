---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// ── Build graph data: nodes and edges ──────────────────────────
// Nodes = Tags + Posts; edges = Post -> each of its Tags.
// Serialized into a <script type="application/json"> element and read
// by d3-force on the client. Avoid define:vars so the script isn't
// inlined (which would drop data-astro-rerun).

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const nodeId = (kind: "tag" | "post", name: string) => `${kind}:${name}`;

const nodes: Array<{
  id: string;
  kind: "tag" | "post";
  label: string;
  href: string;
  size: number;
}> = [];
const links: Array<{ source: string; target: string }> = [];
const seen = new Set<string>();

for (const post of posts) {
  const pid = nodeId("post", post.id);
  if (!seen.has(pid)) {
    seen.add(pid);
    nodes.push({
      id: pid,
      kind: "post",
      label: post.data.title,
      href: `/blog/${post.id}`,
      size: 1,
    });
  }
  for (const tag of post.data.tags || []) {
    const tid = nodeId("tag", tag);
    if (!seen.has(tid)) {
      seen.add(tid);
      nodes.push({
        id: tid,
        kind: "tag",
        label: tag,
        href: `/tags/${encodeURIComponent(tag)}`,
        size: 0,
      });
    }
    links.push({ source: pid, target: tid });
  }
}

// Tag node size = number of attached posts (more related, more prominent)
const tagWeight = new Map<string, number>();
for (const l of links) {
  const tag = nodes.find((n) => n.id === l.target);
  if (tag) tagWeight.set(tag.id, (tagWeight.get(tag.id) || 0) + 1);
}
for (const n of nodes) {
  if (n.kind === "tag") n.size = tagWeight.get(n.id) || 1;
}

const graphData = JSON.stringify({ nodes, links });
---

<BaseLayout title="Tags">
  <div class="page container graph-page">
    <h1>Tags</h1>
    <p class="hint">
      Tags centered · Posts orbiting · Drag nodes · Scroll to zoom · Hover to highlight · Click to
      navigate
    </p>

    {nodes.length > 0 ? (
      <div class="graph-wrap">
        <svg id="tag-graph" role="img" aria-label="Tags knowledge graph">
          <g id="graph-links"></g>
          <g id="graph-nodes"></g>
        </svg>
      </div>
    ) : (
      <p class="empty">No tags yet.</p>
    )}

    <script type="application/json" id="graph-data" set:html={graphData}></script>
  </div>
</BaseLayout>

<script>
// ── Force-directed tag graph (Obsidian graph-view style) ────────
// Layout via d3-force; this script is bundled by Astro into an external
// module (so import resolves normally). Do NOT use data-astro-rerun here:
// it would keep the script inline and break the import. Instead we listen
// for astro:after-swap and re-initialize after view-transition navigations.
// No arrows: edges are plain segments without directional markers.
import * as d3force from "d3-force";
import { navigate } from "astro:transitions/client";

function initGraph() {
  const dataEl = document.getElementById("graph-data");
  const svg = document.getElementById("tag-graph");
  if (!dataEl || !svg) return;
  const svgNS = "http://www.w3.org/2000/svg";

  let data;
  try {
    data = JSON.parse(dataEl.textContent);
  } catch (e) {
    return;
  }
  if (!data.nodes || !data.links || !data.nodes.length) return;

  // Clear any previous graph when re-running after navigation
  svg.textContent = "";

  const wrap = svg.parentElement;
  const W = wrap ? wrap.clientWidth : 800;
  const H = wrap ? wrap.clientHeight : 600;
  svg.setAttribute("viewBox", "0 0 " + W + " " + H);

  // Read theme variables so the graph follows the active theme
  const cs = getComputedStyle(document.documentElement);
  const accent = cs.getPropertyValue("--accent").trim() || "#888";
  const fg = cs.getPropertyValue("--foreground").trim() || "#333";
  const muted = cs.getPropertyValue("--muted-foreground").trim() || "#999";
  const border = cs.getPropertyValue("--border").trim() || "#ccc";
  const codeBg = cs.getPropertyValue("--code-bg").trim() || "#fff";

  const gLinks = document.createElementNS(svgNS, "g");
  gLinks.setAttribute("id", "graph-links");
  const gNodes = document.createElementNS(svgNS, "g");
  gNodes.setAttribute("id", "graph-nodes");
  const view = document.createElementNS(svgNS, "g");
  view.setAttribute("id", "graph-view");
  view.appendChild(gLinks);
  view.appendChild(gNodes);
  svg.appendChild(view);

  const nodes = data.nodes.map((n) => ({ ...n }));
  const links = data.links.map((l) => ({ source: l.source, target: l.target }));

  // ── Deterministic anchors: tags centered, posts orbiting ──
  // Tags sit on a small central ring; each post sits on the outer ring at
  // the mean angle of its tag anchors. Lines converge toward the center and
  // barely cross, so it's easy to see which posts hang under which tags.
  const cx = W / 2;
  const cy = H / 2;
  const tagNodes = nodes.filter((n) => n.kind === "tag");
  const postNodes = nodes.filter((n) => n.kind === "post");

  // Central ring radius: grows slightly with tag count to leave room for labels
  const Rtag = Math.max(56, Math.min(W, H) * (tagNodes.length > 4 ? 0.2 : 0.16));
  tagNodes.forEach((n, i) => {
    const angle = (2 * Math.PI * i) / Math.max(tagNodes.length, 1) - Math.PI / 2;
    n.tx = cx + Rtag * Math.cos(angle);
    n.ty = cy + Rtag * Math.sin(angle);
    n.angle = angle;
  });

  // Outer ring radius for posts
  const Rout = Math.min(W, H) * 0.36;
  postNodes.forEach((n, i) => {
    const related = links.filter((l) => l.source === n.id || l.target === n.id);
    const angles = related
      .map((l) => (l.source === n.id ? l.target : l.source))
      .map((id) => nodes.find((x) => x.id === id))
      .filter(Boolean)
      .map((t) => t.angle);
    // Mean of multiple tag angles (atan2 avoids the 350°+10°->180° wraparound bug)
    const angle =
      angles.length > 0
        ? Math.atan2(
            angles.reduce((s, a) => s + Math.sin(a), 0) / angles.length,
            angles.reduce((s, a) => s + Math.cos(a), 0) / angles.length,
          )
        : (2 * Math.PI * i) / Math.max(postNodes.length, 1) - Math.PI / 2;
    n.tx = cx + Rout * Math.cos(angle);
    n.ty = cy + Rout * Math.sin(angle);
  });

  // Uniform node size (posts and tags look the same; type is told apart by color)
  const rOf = () => 8;

  // ── Simulation: anchored positions dominate, links assist, fast settle ──
  const simulation = d3force
    .forceSimulation(nodes)
    .force(
      "link",
      d3force
        .forceLink(links)
        .id((d) => d.id)
        .distance(60)
        .strength(0.35),
    )
    .force("x", d3force.forceX((d) => d.tx).strength(0.3))
    .force("y", d3force.forceY((d) => d.ty).strength(0.3))
    .force(
      "collide",
      d3force
        .forceCollide()
        .radius((d) => rOf(d) + 14)
        .strength(0.9),
    )
    .velocityDecay(0.6) // high velocity decay -> oscillation dies quickly
    .alpha(1)
    .alphaDecay(0.06); // fast convergence: initial layout settles in a few frames, no bounce after drag

  // Draw edges
  const linkSel = [];
  for (const l of links) {
    const line = document.createElementNS(svgNS, "line");
    line.setAttribute("class", "graph-link");
    line.setAttribute("stroke", border);
    line.setAttribute("stroke-width", "1.2");
    gLinks.appendChild(line);
    linkSel.push({ el: line, data: l });
  }

  // Draw nodes
  // Drag state lives outside the loop (global). mousemove/mouseup are bound
  // once on window: nodes are only 8px, so once the pointer leaves a node the
  // per-node handlers would stop firing. Moving/releasing must rely on global
  // events.
  let dragNode = null;
  let dragged = false;
  let startX = 0;
  let startY = 0;
  let movedByDrag = false;
  const nodeSel = nodes.map((d) => {
    const g = document.createElementNS(svgNS, "g");
    g.setAttribute("class", "graph-node");

    const circle = document.createElementNS(svgNS, "circle");
    circle.setAttribute("r", rOf(d));
    circle.setAttribute("fill", d.kind === "post" ? accent : muted);
    circle.setAttribute("opacity", d.kind === "post" ? "0.9" : "0.8");
    g.appendChild(circle);

    // Tag nodes show their name; post nodes show the title on hover
    if (d.kind === "tag") {
      const text = document.createElementNS(svgNS, "text");
      text.setAttribute("dy", rOf(d) + 13);
      text.setAttribute("text-anchor", "middle");
      text.setAttribute("class", "graph-label");
      text.setAttribute("fill", fg);
      text.textContent = d.label;
      g.appendChild(text);
    } else {
      const tip = document.createElementNS(svgNS, "title");
      tip.textContent = d.label;
      g.appendChild(tip);
    }

    // Mouse down: record a drag candidate (simulation not started yet)
    g.addEventListener("mousedown", (e) => {
      e.stopPropagation();
      dragged = false;
      startX = e.clientX;
      startY = e.clientY;
      dragNode = d;
      d.fx = d.x;
      d.fy = d.y;
    });

    // Hover highlight: brighten self + neighbors, dim the rest
    g.addEventListener("mouseenter", () => hoverNode(d));
    g.addEventListener("mouseleave", () => hoverNode(null));

    gNodes.appendChild(g);
    return { el: g, data: d };
  });

  // Pan / zoom state
  const pan = { k: 1, x: 0, y: 0 };
  function applyTransform() {
    view.setAttribute("transform", "translate(" + pan.x + "," + pan.y + ") scale(" + pan.k + ")");
  }

  // Press on empty canvas to start panning
  let panning = false;
  let px = 0;
  let py = 0;

  // Hover
  function hoverNode(d) {
    const neighbors = new Set();
    if (d) {
      neighbors.add(d);
      for (const l of links) {
        if (l.source === d) neighbors.add(l.target);
        if (l.target === d) neighbors.add(l.source);
      }
    }
    for (const n of nodeSel) {
      const on = !d || neighbors.has(n.data);
      n.el.style.opacity = on ? "1" : "0.15";
      n.el.style.transition = "opacity 0.15s ease";
    }
    for (const l of linkSel) {
      const on = !d || l.data.source === d || l.data.target === d;
      l.el.style.opacity = on ? "1" : "0.08";
      l.el.style.transition = "opacity 0.15s ease";
    }
  }

  // ── Global mouse handlers (registered once; old ones removed on re-runs) ──
  const onMove = (e) => {
    // Dragging a node
    if (dragNode) {
      if (Math.abs(e.clientX - startX) + Math.abs(e.clientY - startY) > 3) {
        dragged = true;
        movedByDrag = true;
      }
      if (dragged) {
        // Cache the svg rect to avoid a reflow on every mousemove
        const rect = svg.getBoundingClientRect();
        dragNode.fx = (e.clientX - rect.left - pan.x) / pan.k;
        dragNode.fy = (e.clientY - rect.top - pan.y) / pan.k;
        // Let other nodes drift aside; fx/fy drive the dragged node itself
        simulation.alpha(0.25).restart();
      }
    }
    // Pan the canvas
    if (panning) {
      pan.x += e.clientX - px;
      pan.y += e.clientY - py;
      px = e.clientX;
      py = e.clientY;
      applyTransform();
    }
  };
  const onUp = () => {
    if (dragNode) {
      const d = dragNode;
      dragNode = null;
      if (movedByDrag) {
        // Dragged: pin the node where it was dropped (Obsidian style) and stop
        // the simulation so link/collide forces can't yank it back ("sling").
        d.fx = d.x;
        d.fy = d.y;
        simulation.stop();
      } else {
        // Plain click: navigate with a view transition (smooth, like Astro links)
        navigate(d.href);
      }
      dragged = false;
      movedByDrag = false;
    }
    panning = false;
  };
  window.removeEventListener("mousemove", onMove);
  window.removeEventListener("mouseup", onUp);
  window.addEventListener("mousemove", onMove);
  window.addEventListener("mouseup", onUp);

  // Press on empty canvas to start panning
  svg.addEventListener("mousedown", (e) => {
    if (e.target !== svg && e.target !== gLinks) return;
    panning = true;
    px = e.clientX;
    py = e.clientY;
  });

  // Wheel zoom (anchored at the pointer)
  svg.addEventListener(
    "wheel",
    (e) => {
      e.preventDefault();
      const rect = svg.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      const factor = e.deltaY < 0 ? 1.1 : 1 / 1.1;
      const k2 = Math.min(3, Math.max(0.3, pan.k * factor));
      pan.x = mx - ((mx - pan.x) * k2) / pan.k;
      pan.y = my - ((my - pan.y) * k2) / pan.k;
      pan.k = k2;
      applyTransform();
    },
    { passive: false },
  );

  // Update positions on every tick
  simulation.on("tick", () => {
    for (const { el, data: d } of nodeSel) {
      el.setAttribute("transform", "translate(" + d.x + "," + d.y + ")");
    }
    for (const { el, data: l } of linkSel) {
      el.setAttribute("x1", l.source.x);
      el.setAttribute("y1", l.source.y);
      el.setAttribute("x2", l.target.x);
      el.setAttribute("y2", l.target.y);
    }
  });

  applyTransform();
}

initGraph();
// Re-initialize after view-transition navigation (e.g. article page -> Tags)
document.addEventListener("astro:after-swap", () => {
  initGraph();
});
</script>

<style>
.graph-page .container {
  width: 100%;
}
.hint {
  color: var(--muted-foreground);
  font-size: var(--text-sm);
  margin-bottom: 1rem;
}
.graph-wrap {
  position: relative;
  width: 100%;
  height: 70vh;
  min-height: 420px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}
#tag-graph {
  width: 100%;
  height: 100%;
  display: block;
  cursor: grab;
  background: var(--code-bg);
}
#tag-graph.panning {
  cursor: grabbing;
}
.graph-link {
  stroke-linecap: round;
}
.graph-label {
  font-size: 0.8em;
  font-weight: 500;
  pointer-events: none;
  paint-order: stroke;
  stroke: var(--graph-bg, var(--code-bg));
  stroke-width: 3px;
  stroke-linejoin: round;
}
.graph-node {
  cursor: pointer;
}
.graph-node text {
  user-select: none;
}
.empty {
  text-align: center;
  color: var(--muted-foreground);
  padding: 3rem 0;
}
@media (max-width: 640px) {
  .graph-wrap {
    height: 55vh;
  }
}
</style>
